{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
VOLUME DISCOUNT WIDGET
----------------------------------------------------------------------------------------------------------------------

PDP "Buy More, Save More" tier widget. Visual / educational only — actual discount enforcement happens via
Shopify Admin → Discounts (automatic order discounts). See the commit message and project handoff doc for setup.

********************************************
Supported variables
********************************************

* block: the section block, providing tier config from theme editor
* product: the current product
* product_form_id: id of the product form (needed to wire qty listener)
{%- endcomment -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign unit_price_cents = variant.price

  assign t1_qty = block.settings.tier1_qty | default: 2
  assign t1_pct = block.settings.tier1_pct | default: 15
  assign t2_qty = block.settings.tier2_qty | default: 3
  assign t2_pct = block.settings.tier2_pct | default: 20
  assign t3_qty = block.settings.tier3_qty | default: 4
  assign t3_pct = block.settings.tier3_pct | default: 25
  assign heading = block.settings.heading | default: 'Buy More, Save More'
-%}

{%- capture tiers_json -%}
[{"min_qty":{{ t1_qty }},"discount_pct":{{ t1_pct }}},{"min_qty":{{ t2_qty }},"discount_pct":{{ t2_pct }}},{"min_qty":{{ t3_qty }},"discount_pct":{{ t3_pct }}}]
{%- endcapture -%}

<style>
  .volume-discount {
    --vd-border: var(--border-color, rgba(0, 0, 0, 0.12));
    --vd-active-bg: var(--accent, #ff6b6b);
    --vd-active-fg: #ffffff;

    display: block;
    margin-block: var(--spacing-1, 0.5rem) var(--spacing-2, 1rem);
  }

  .volume-discount__heading {
    font-weight: 600;
    font-size: 0.95rem;
    margin-block-end: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .volume-discount__icon {
    flex-shrink: 0;
  }

  .volume-discount__tiers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .volume-discount__tier {
    border: 1.5px solid var(--vd-border);
    border-radius: var(--border-radius-md, 8px);
    padding: 0.75rem 0.5rem;
    text-align: center;
    transition: border-color 0.15s ease, background-color 0.15s ease, transform 0.15s ease;
    cursor: pointer;
    background: transparent;
    position: relative;
  }

  .volume-discount__tier:hover {
    border-color: var(--vd-active-bg);
  }

  .volume-discount__tier-qty {
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.2;
    margin-block-end: 0.2rem;
  }

  .volume-discount__tier-save {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1;
    color: var(--vd-active-bg);
  }

  .volume-discount__tier-each {
    font-size: 0.7rem;
    opacity: 0.7;
    margin-block-start: 0.3rem;
    line-height: 1.2;
  }

  .volume-discount__tier--active {
    background: var(--vd-active-bg);
    border-color: var(--vd-active-bg);
    transform: scale(1.02);
  }

  .volume-discount__tier--active .volume-discount__tier-qty,
  .volume-discount__tier--active .volume-discount__tier-save,
  .volume-discount__tier--active .volume-discount__tier-each {
    color: var(--vd-active-fg);
  }

  .volume-discount__tier--active::after {
    content: "✓";
    position: absolute;
    top: 0.25rem;
    right: 0.4rem;
    font-size: 0.75rem;
    color: var(--vd-active-fg);
    font-weight: 700;
  }

  .volume-discount__status {
    font-size: 0.85rem;
    margin-block-start: 0.55rem;
    text-align: center;
    color: var(--vd-active-bg);
    font-weight: 600;
    min-height: 1.1em;
  }

  .volume-discount__note {
    font-size: 0.7rem;
    opacity: 0.55;
    text-align: center;
    margin-block-start: 0.25rem;
    line-height: 1.3;
  }

  @media (max-width: 480px) {
    .volume-discount__tier-qty { font-size: 0.8rem; }
    .volume-discount__tier-save { font-size: 0.95rem; }
    .volume-discount__tier-each { font-size: 0.65rem; }
  }
</style>

<volume-discount
  class="volume-discount"
  form="{{ product_form_id }}"
  unit-price="{{ unit_price_cents }}"
  tiers="{{ tiers_json | escape }}"
  data-currency-symbol="{{ cart.currency.symbol }}"
>
  <div class="volume-discount__heading">
    <svg class="volume-discount__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 12v10H4V12"></path>
      <path d="M2 7h20v5H2z"></path>
      <path d="M12 22V7"></path>
      <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
      <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
    </svg>
    {{ heading }}
  </div>

  <div class="volume-discount__tiers" role="group" aria-label="{{ heading | escape }}">
    {%- assign tier_qtys = t1_qty | append: ',' | append: t2_qty | append: ',' | append: t3_qty | split: ',' -%}
    {%- assign tier_pcts = t1_pct | append: ',' | append: t2_pct | append: ',' | append: t3_pct | split: ',' -%}

    {%- for i in (0..2) -%}
      {%- assign qty = tier_qtys[i] | times: 1 -%}
      {%- assign pct = tier_pcts[i] | times: 1 -%}
      {%- assign discount_cents = unit_price_cents | times: pct | divided_by: 100 -%}
      {%- assign each_price = unit_price_cents | minus: discount_cents -%}

      <button
        type="button"
        class="volume-discount__tier"
        data-tier-index="{{ i }}"
        data-tier-qty="{{ qty }}"
        data-tier-pct="{{ pct }}"
        aria-label="Buy {{ qty }}{% if i == 2 %} or more{% endif %}, save {{ pct }} percent"
      >
        <div class="volume-discount__tier-qty">
          Buy {{ qty }}{% if i == 2 %}+{% endif %}
        </div>
        <div class="volume-discount__tier-save">
          Save {{ pct }}%
        </div>
        <div class="volume-discount__tier-each">
          {{ each_price | money }} each
        </div>
      </button>
    {%- endfor -%}
  </div>

  <div class="volume-discount__status" data-savings aria-live="polite" hidden></div>
  <div class="volume-discount__note">Discount applied automatically at checkout</div>
</volume-discount>

<script>
  (function () {
    if (window.customElements.get('volume-discount')) return;

    class VolumeDiscount extends HTMLElement {
      connectedCallback() {
        const formId = this.getAttribute('form');
        if (!formId) return;

        this.qtyInput = document.querySelector('input[name="quantity"][form="' + formId + '"]');
        if (!this.qtyInput) return;

        try {
          this.tiers = JSON.parse(this.getAttribute('tiers') || '[]');
        } catch (_) {
          this.tiers = [];
        }
        this.unitPrice = parseInt(this.getAttribute('unit-price') || '0', 10);
        this.currencySymbol = this.dataset.currencySymbol || '$';

        this._onQtyChange = this._onQtyChange.bind(this);
        this._onTierClick = this._onTierClick.bind(this);

        this.qtyInput.addEventListener('input', this._onQtyChange);
        this.qtyInput.addEventListener('change', this._onQtyChange);

        this.querySelectorAll('[data-tier-index]').forEach((tierEl) => {
          tierEl.addEventListener('click', this._onTierClick);
        });

        this._onQtyChange();
      }

      disconnectedCallback() {
        if (this.qtyInput) {
          this.qtyInput.removeEventListener('input', this._onQtyChange);
          this.qtyInput.removeEventListener('change', this._onQtyChange);
        }
        this.querySelectorAll('[data-tier-index]').forEach((tierEl) => {
          tierEl.removeEventListener('click', this._onTierClick);
        });
      }

      _onTierClick(event) {
        const targetQty = parseInt(event.currentTarget.dataset.tierQty, 10);
        if (!targetQty || !this.qtyInput) return;
        this.qtyInput.value = String(targetQty);
        this.qtyInput.dispatchEvent(new Event('input', { bubbles: true }));
        this.qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
      }

      _onQtyChange() {
        const qty = parseInt(this.qtyInput.value, 10) || 1;

        let activeIndex = -1;
        for (let i = 0; i < this.tiers.length; i++) {
          if (qty >= this.tiers[i].min_qty) activeIndex = i;
        }

        this.querySelectorAll('[data-tier-index]').forEach((card) => {
          const idx = parseInt(card.dataset.tierIndex, 10);
          card.classList.toggle('volume-discount__tier--active', idx === activeIndex);
        });

        const savedEl = this.querySelector('[data-savings]');
        if (!savedEl) return;

        if (activeIndex >= 0 && this.unitPrice > 0) {
          const tier = this.tiers[activeIndex];
          const savedCents = Math.round((this.unitPrice * qty * tier.discount_pct) / 100);
          const dollars = (savedCents / 100).toFixed(2);
          savedEl.textContent = "You're saving " + this.currencySymbol + dollars + '!';
          savedEl.hidden = false;
        } else if (this.tiers.length > 0) {
          const nextTier = this.tiers[0];
          const needed = Math.max(nextTier.min_qty - qty, 0);
          if (needed > 0) {
            savedEl.textContent = 'Add ' + needed + ' more to save ' + nextTier.discount_pct + '%';
            savedEl.hidden = false;
          } else {
            savedEl.hidden = true;
          }
        } else {
          savedEl.hidden = true;
        }
      }
    }

    customElements.define('volume-discount', VolumeDiscount);
  })();
</script>
